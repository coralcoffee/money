{
  "name": "money",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "webui"
  ],
  "main": "dist/desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev:webui": "npm run start --workspace @money/ui",
    "clean:3000": "npx kill-port 3000",
    "lint:webui": "npm run lint --workspace @money/ui",
    "preview:webui": "npm run preview --workspace @money/ui",
    "preview:ev": "electron-vite preview",
    "start": "node ./scripts/start-electron-vite-dev.cjs",
    "start:clean": "npm run clean:3000 && npm run start",
    "build:webui": "npm run build --workspace @money/ui",
    "build:ev": "electron-vite build",
    "build": "npm run build:ev && npm run build:webapi",
    "build:webapi": "dotnet publish ./webapi/src/Money.HttpApi.Host/Money.HttpApi.Host.csproj -c Release /p:DebugType=None /p:DebugSymbols=false --sc -o ./dist/webapi /p:UseAppHost=true",
    "pack": "npm run build && electron-builder build --publish never",
    "dist": "npm run build && electron-builder",
    "type-check": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/node": "^24.5.2",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "kill-port": "^2.0.1",
    "typescript": "^5.9.2"
  }
}
